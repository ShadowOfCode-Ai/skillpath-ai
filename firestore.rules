rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'gootymahind@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles: read/write by owner or admin
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();

      // Resume: Read-only for owner; written only by server API
      match /resume/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Server-only writes to protect verified integrity
      }

      // Assessments: Read-only for owner; created and graded exclusively by server API
      match /assessments/{assessmentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Server-only writes to prevent answer forging
      }

      // Roadmap progress: Owner can read and update step progress
      match /roadmap/{roleId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidId(roleId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Saved opportunities: Owner can read, bookmark, and unbookmark
      match /saved/{opportunityId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidId(opportunityId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Opportunities: Publicly readable by authenticated users; writable only by Admins
    match /opportunities/{opportunityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // App Settings: Readable by signed-in users, writable only by Admins
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admins marker collection: Readable by signed-in users; writable only by Admins
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
